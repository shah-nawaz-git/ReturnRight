# ReturnRight local dev defaults. Copy to .env and adjust as needed.
# .env is gitignored; never commit real secrets.
#
# The .NET API reads these via standard configuration environment variables:
# docker-compose maps POSTGRES_* into ConnectionStrings__Default etc. using
# the double-underscore (__) separator convention.

# PostgreSQL
POSTGRES_DB=returnright
POSTGRES_USER=returnright
POSTGRES_PASSWORD=returnright
# Npgsql-format connection string used by the API.
DATABASE_URL=Host=localhost;Port=5432;Database=returnright;Username=returnright;Password=returnright

# Mailpit (SMTP sink + web UI on 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ReturnRight <no-reply@returnright.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false

# Reminder processing worker (API). Polls for due reminders and sends
# email/in-app notifications. Failed sends retry after each delay, then fail.
REMINDERS_POLL_INTERVAL_SECONDS=30
REMINDERS_RETRY_DELAY_1=5
REMINDERS_RETRY_DELAY_2=30
REMINDERS_RETRY_DELAY_3=120

# Python document extractor service
EXTRACTOR_URL=http://localhost:8000
# Optional shared secret between the API and the extractor. When set, the
# extractor requires the X-Extractor-Key header on /extract and the API sends
# it (Extractor__SharedSecret). Leave empty to disable.
EXTRACTOR_SHARED_SECRET=

# Local file storage root (uploads/evidence outside the DB)
FILE_STORAGE_PATH=./storage
# Max upload size accepted by the API (bytes); 10 MB by default.
# Mapped to Storage__MaxUploadBytes in docker-compose.
STORAGE_MAX_UPLOAD_BYTES=10485760

# Auth cookie hardening. Keep false for plain-http local dev and compose;
# set true behind HTTPS so rr.auth/rr.csrf get the Secure flag.
# Mapped to Auth__RequireSecureCookie in docker-compose.
AUTH_REQUIRE_SECURE_COOKIE=false

# Rate limiting (API). Auth endpoints are limited per IP, uploads per user.
RATELIMIT_ENABLED=true
RATELIMIT_AUTH_PERMIT_LIMIT=10
RATELIMIT_UPLOADS_PERMIT_LIMIT=20

# Expired document-intake cleanup interval (minutes).
INTAKE_CLEANUP_INTERVAL_MINUTES=15

# Web app (Next.js) public base URL
APP_BASE_URL=http://localhost:3000
# Server-side URL the web app uses to reach the API (rewrite proxy target)
API_INTERNAL_URL=http://localhost:5080

# Demo seeding
DEMO_PASSWORD=
SEED_DEMO_DATA=true

# Local override for the tesseract binary (leave empty in Docker —
# the image ships tesseract-ocr). Example:
# TESSERACT_CMD=C:\Users\hp\tools\rr\tesseract\tesseract.exe
TESSERACT_CMD=
